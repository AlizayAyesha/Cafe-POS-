# =============================================================================
# LOCAL development (copy to .env) — use Docker Postgres or Neon
# =============================================================================
# Local (no Docker): SQLite file — run `npm run dev`
DATABASE_URL="file:./dev.db"

# Local with Docker Postgres: docker compose up -d && npm run dev:postgres
# DATABASE_URL="postgresql://cafepos:cafepos@localhost:5432/cafepos?schema=public"

AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Local demo seed only. Used when creating demo users that do not exist yet.
# Existing passwords are never replaced. Not used by the hosted setup route.
DEMO_SEED_PASSWORD="choose-a-local-password-8-chars-min"

# One-time first admin on an EMPTY database. Leave disabled.
# ENABLE_INITIAL_ADMIN_SETUP="true"
# SETUP_SECRET="long-random-string"
# INITIAL_ADMIN_EMAIL="owner@example.com"
# INITIAL_ADMIN_PASSWORD="long-random-password-12-chars-min"

# =============================================================================
# VERCEL production — set these in Vercel → Project → Settings → Environment
# Variables (Production). Do NOT put file:./dev.db here. SQLite will not work.
# =============================================================================
# DATABASE_URL   = postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#                  (from Neon / Supabase / Vercel Postgres)
# AUTH_SECRET    = long random string (openssl rand -base64 32)
# NEXTAUTH_SECRET= same as AUTH_SECRET
# AUTH_URL       = https://cafe-pos-inky-zeta.vercel.app
# NEXTAUTH_URL   = https://cafe-pos-inky-zeta.vercel.app
#
# After setting env vars: redeploy. Create the empty schema with
#   DATABASE_URL="your-neon-url" npx prisma db push
# Do not run db:seed against that database.
#
# First admin on an empty production database (does not seed the demo menu):
#   ENABLE_INITIAL_ADMIN_SETUP=true
#   SETUP_SECRET=<long random>
#   INITIAL_ADMIN_EMAIL=<owner email>
#   INITIAL_ADMIN_PASSWORD=<12+ characters>
#   curl -X POST https://cafe-pos-inky-zeta.vercel.app/api/setup \
#     -H "x-setup-secret: $SETUP_SECRET"
# Then remove ENABLE_INITIAL_ADMIN_SETUP and redeploy.
# Do not run db:seed against production. Builds do not seed.
# Rotating any previously exposed demo password is a separate live step.
